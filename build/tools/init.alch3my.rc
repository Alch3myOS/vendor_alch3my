# ==========================================
# Alch3myOS Transmutation Hub Matrix
# ==========================================

# LEAD PROFILE (Maximum Battery / Downclock)
on property:persist.sys.alch3my.profile=lead
    # Set CPU governors to powersave or conservative
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor powersave
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor powersave
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor powersave
    # Drop max background cached apps
    write /sys/module/lowmemorykiller/parameters/enable_adaptive_lmk 1
    # Log the transmutation
    write /dev/kmsg "Alch3myOS: Transmuted to LEAD (Powersave)"

# MERCURY PROFILE (Balanced Everyday Use)
on property:persist.sys.alch3my.profile=mercury
    # Return CPU to standard schedutil for balanced scaling
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor schedutil
    write /dev/kmsg "Alch3myOS: Transmuted to MERCURY (Balanced)"

# GOLD PROFILE (Max Performance / Gaming)
on property:persist.sys.alch3my.profile=gold
    # Force CPU to maximum performance (pegged frequencies)
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor performance
    # Disable adaptive Low Memory Killer to keep heavy games alive
    write /sys/module/lowmemorykiller/parameters/enable_adaptive_lmk 0
    write /dev/kmsg "Alch3myOS: Transmuted to GOLD (Performance)"
