cc_prebuilt_library_shared {
    name: "libjson",
    owner: "google",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["libjson.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    prefer: true,
    soc_specific: true,
}
